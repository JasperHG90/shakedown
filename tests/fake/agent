#!/usr/bin/env python3
"""A fake harness: deterministic stream-json, no network, no cost.

Counts its own invocations so tests can assert the runner does not execute
more often than it should.
"""
import json, os, sys
from pathlib import Path

args = sys.argv[1:]
prompt = args[args.index("-p") + 1] if "-p" in args else ""
resuming = "--resume" in args

counter = Path(os.environ.get("FAKE_COUNTER", "/tmp/fake-agent-count"))
counter.write_text(str(int(counter.read_text() or 0) + 1) if counter.exists() else "1")

def emit(obj): print(json.dumps(obj), flush=True)

emit({"type": "system", "subtype": "init", "skills": ["fake-skill"], "mcp_servers": []})
emit({"type": "assistant", "message": {"content": [
    {"type": "tool_use", "name": "Skill", "input": {"skill": "fake-skill"}}]}})

if "owner" not in prompt.lower() and not resuming:
    emit({"type": "assistant", "message": {"content": [
        {"type": "text", "text": "Who owns this work?"}]}})
    emit({"type": "result", "permission_denials": []})
    sys.exit(0)

owner = prompt if resuming else "platform-team"
emit({"type": "assistant", "message": {"content": [
    {"type": "tool_use", "name": "Bash", "input": {"command": f"faketool write --owner {owner}"}}]}})
Path("OUT.md").write_text(f"# Plan\nOwner: {owner}\n")
emit({"type": "result", "permission_denials": []})
