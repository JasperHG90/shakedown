#!/usr/bin/env python3
"""A fake harness: deterministic stream-json, no network, no cost.

Keeps session state in the workspace so resume actually carries context,
and asks for missing facts one at a time.
"""
import json, os, sys
from pathlib import Path

args = sys.argv[1:]
text = args[args.index("-p") + 1] if "-p" in args else ""
resuming = "--resume" in args

# Append, never read-modify-write: parallel workers race and lose counts.
counter = Path(os.environ.get("FAKE_COUNTER", "/tmp/fake-agent-count"))
with counter.open("a") as fh:
    fh.write("x\n")

state_path = Path(".fake-state.json")
state = json.loads(state_path.read_text()) if resuming and state_path.exists() else {}
state.setdefault("known", {})
state.setdefault("pending", None)

def emit(obj): print(json.dumps(obj), flush=True)

WANTED = ("owner", "title")

if resuming and state["pending"]:
    state["known"][state["pending"]] = text.strip()
    state["pending"] = None
else:
    for field in WANTED:
        marker = f"{field}:"
        if marker in text.lower():
            state["known"][field] = text.lower().split(marker, 1)[1].split(".")[0].strip()

emit({"type": "system", "subtype": "init", "skills": ["fake-skill"], "mcp_servers": []})
emit({"type": "assistant", "message": {"content": [
    {"type": "tool_use", "name": "Skill", "input": {"skill": "fake-skill"}}]}})

missing = [f for f in WANTED if f not in state["known"]]
if missing:
    state["pending"] = missing[0]
    state_path.write_text(json.dumps(state))
    emit({"type": "assistant", "message": {"content": [
        {"type": "text", "text": f"What is the {missing[0]} for this work?"}]}})
    emit({"type": "result", "permission_denials": []})
    sys.exit(0)

state_path.write_text(json.dumps(state))
known = state["known"]
emit({"type": "assistant", "message": {"content": [{"type": "tool_use", "name": "Bash",
      "input": {"command": f"faketool write --owner {known['owner']} --title {known['title']}"}}]}})
Path("OUT.md").write_text(f"# {known['title']}\nOwner: {known['owner']}\n")
emit({"type": "result", "permission_denials": []})
