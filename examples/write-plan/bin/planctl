#!/usr/bin/env python3
"""Render PLAN.md from a fixed template. The deterministic half."""

import argparse
import sys
from pathlib import Path

TEMPLATE = """# {title}

- **Owner:** {owner}

## Objective

{title} is owned by {owner}.
"""


def main() -> int:
    """Write PLAN.md, or refuse."""
    p = argparse.ArgumentParser(prog="planctl")
    sub = p.add_subparsers(dest="cmd", required=True)
    w = sub.add_parser("write")
    w.add_argument("--title", required=True)
    w.add_argument("--owner", required=True)
    w.add_argument("--dir", default=".")
    a = p.parse_args()

    target = Path(a.dir) / "PLAN.md"
    if target.exists():
        print(f"{target} exists; refusing to overwrite", file=sys.stderr)
        return 3
    target.write_text(TEMPLATE.format(title=a.title, owner=a.owner))
    print(f"wrote {target}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
