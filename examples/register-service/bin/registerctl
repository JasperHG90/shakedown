#!/usr/bin/env bash
# Register a service with the shared gateway: clone the platform repo, write
# services/<name>.yaml and the CODEOWNERS line, commit, push, open the PR.
#
# Everything that reaches the network goes through `gh`, which is what makes
# this skill measurable: a cases file supplies a `gh` that records the calls
# instead of making them. `git` runs for real against whatever `gh repo clone`
# produced.
set -euo pipefail

PLATFORM_SLUG="${PLATFORM_SLUG:-acme/platform}"
BASE_BRANCH="main"
REGION="eu-west-1"
NAME="" HOST="" TEST_PROJECT="" ACC_PROJECT="" PROD_PROJECT=""
OWNERS=()

die() { echo "registerctl: $*" >&2; exit 2; }

# An empty value is refused rather than read as an omission: `--test-project
# "$PROJET"` with the variable misspelled would otherwise drop the tier and
# still exit 0, registering fewer tiers than were asked for.
need() { [[ -n "${2:-}" ]] || die "$1 was given an empty value"; echo "$2"; }

while [[ $# -gt 0 ]]; do
  case "$1" in
    --name)         NAME="$(need "$1" "${2:-}")"; shift 2 ;;
    --host)         HOST="$(need "$1" "${2:-}")"; shift 2 ;;
    --owner)        OWNERS+=("$(need "$1" "${2:-}")"); shift 2 ;;
    --region)       REGION="$(need "$1" "${2:-}")"; shift 2 ;;
    --test-project) TEST_PROJECT="$(need "$1" "${2:-}")"; shift 2 ;;
    --acc-project)  ACC_PROJECT="$(need "$1" "${2:-}")"; shift 2 ;;
    --prod-project) PROD_PROJECT="$(need "$1" "${2:-}")"; shift 2 ;;
    *) die "unknown argument: $1" ;;
  esac
done

[[ -n "$NAME" ]] || die "--name is required"
[[ -n "$HOST" ]] || die "--host is required"
[[ ${#OWNERS[@]} -gt 0 ]] || die "--owner is required"
[[ -n "$TEST_PROJECT$ACC_PROJECT$PROD_PROJECT" ]] \
  || die "at least one of --test-project, --acc-project, --prod-project is required"

# A shape check, not an existence check: it catches an uppercase project or a
# zone passed where a region belongs before either is pasted into the middle of
# a URL nobody reads before merging.
shaped() { [[ "$2" =~ ^[a-z][a-z0-9-]{2,62}$ ]] || die "$1 is not a valid identifier: $2"; }
shaped --name "$NAME"
shaped --region "$REGION"
for pair in "--test-project $TEST_PROJECT" "--acc-project $ACC_PROJECT" "--prod-project $PROD_PROJECT"; do
  [[ -n "${pair#* }" ]] && shaped "${pair%% *}" "${pair#* }"
done

command -v gh >/dev/null || die "gh not found"
gh auth status --hostname github.com >/dev/null 2>&1 \
  || die "gh is not authenticated; run 'gh auth login'"

link() { echo "https://gateway.example.com/projects/$1/regions/$REGION/backends/$NAME"; }

WORKDIR="$(mktemp -d "${TMPDIR:-/tmp}/registerctl.XXXXXX")"
trap 'rm -rf "$WORKDIR"' EXIT
REPO="$WORKDIR/platform"

# `gh repo clone` rather than `git clone`, so the URL and the credentials both
# come from the login checked above.
gh repo clone "$PLATFORM_SLUG" "$REPO" -- --quiet || die "could not clone $PLATFORM_SLUG"
GIT=(git -C "$REPO")
BRANCH="register-$NAME"
"${GIT[@]}" switch --quiet -c "$BRANCH"

mkdir -p "$REPO/services"
{
  echo "# Generated by registerctl. Edit the tiers, not the format."
  echo "name: $NAME"
  echo "host: $HOST"
  echo "owners:"
  for o in "${OWNERS[@]}"; do echo "  - $o"; done
  echo "tiers:"
  [[ -n "$TEST_PROJECT" ]] && { echo "  test:"; echo "    backend: $(link "$TEST_PROJECT")"; }
  [[ -n "$ACC_PROJECT"  ]] && { echo "  acc:";  echo "    backend: $(link "$ACC_PROJECT")"; }
  [[ -n "$PROD_PROJECT" ]] && { echo "  prod:"; echo "    backend: $(link "$PROD_PROJECT")"; }
} > "$REPO/services/$NAME.yaml"

# A file whose last byte is not a newline would otherwise get this glued onto
# its last rule, corrupting that rule instead of adding one.
codeowners="$REPO/CODEOWNERS"
if [[ -f "$codeowners" ]]; then
  line="/services/$NAME.yaml ${OWNERS[*]}"
  grep -qxF "$line" "$codeowners" || {
    [[ -z "$(tail -c1 "$codeowners")" ]] || echo >> "$codeowners"
    echo "$line" >> "$codeowners"
  }
fi

"${GIT[@]}" add -A
if "${GIT[@]}" diff --cached --quiet "origin/$BASE_BRANCH"; then
  echo "registerctl: $NAME is already registered on $PLATFORM_SLUG@$BASE_BRANCH; nothing to do."
  exit 0
fi
"${GIT[@]}" -c user.email=registerctl@example.com -c user.name=registerctl \
  commit -q -m "Register $NAME with the gateway"
# --force, because every run clones fresh from main: a second attempt after a
# corrected mistake is never a fast-forward, and refusing it would leave the
# first attempt standing as the registration.
"${GIT[@]}" push --quiet --force -u origin "$BRANCH"

url="$(gh --repo "$PLATFORM_SLUG" pr create --base "$BASE_BRANCH" --head "$BRANCH" \
  --title "Register $NAME with the gateway" \
  --body "Registers \`$NAME\` in \`services/$NAME.yaml\` and its CODEOWNERS line.")"
echo "registerctl: opened PR $url"
