#!/usr/bin/env bash
# A `gh` that answers instead of reaching GitHub.
#
# The skill under test clones a repository, edits it, commits, pushes, and
# opens a pull request. Only the four calls that leave the machine are `gh`,
# so replacing `gh` alone is enough: `git` then runs for real against a local
# repository, and every branch, diff, and commit the skill makes is genuine.
#
# Seeded onto PATH ahead of the real `gh` by `fixtures` in the cases file.
# Never inside the skill: a fake `gh` is not something the skill ships.
set -euo pipefail

# PATH holds <workspace>/bin, so $0 locates the workspace without being told.
WORK="$(cd "$(dirname "$0")/.." && pwd)"
REMOTE="$WORK/.gh/platform.git"      # stands in for the platform repository
LOG="$WORK/gh-calls.log"
echo "gh $*" >> "$LOG"

die() { echo "gh (double): $*" >&2; exit 1; }

# The platform repository as it exists before this registration. Two things
# in it are load-bearing rather than decoration:
#
#   CODEOWNERS  registerctl appends to it only if it is there, so a remote
#               without one produces a registration with no ownership rule
#               and the case still passes.
#   legacy.yaml written exactly as registerctl writes one, with its
#               CODEOWNERS line, so re-registering `legacy` reaches the
#               "already registered; nothing to do" path instead of a
#               second pull request.
#
# Built on first use, so no git repository is committed to this one.
seed_remote() {
  [[ -d "$REMOTE" ]] && return
  local seed="$WORK/.gh/seed"
  mkdir -p "$seed/services"
  git init --quiet --initial-branch=main "$seed"
  cat > "$seed/services/legacy.yaml" <<'YAML'
# Generated by registerctl. Edit the tiers, not the format.
name: legacy
host: legacy.services.example.com
owners:
  - @acme/platform
tiers:
  prod:
    backend: https://gateway.example.com/projects/legacy-prod-0001/regions/eu-west-1/backends/legacy
YAML
  printf '* @acme/platform\n/services/legacy.yaml @acme/platform\n' > "$seed/CODEOWNERS"
  git -C "$seed" add -A
  git -C "$seed" -c user.email=platform@example.com -c user.name=platform \
    commit --quiet -m "the platform repository, before this registration"
  git clone --quiet --bare "$seed" "$REMOTE"
}

# What the branch holds, put where `artifact` can read it. The skill's own
# clone is a temp directory it deletes on exit, so without this there is
# nothing left to check.
export_branch() {
  local branch="$1" out="$WORK/pr"
  rm -rf "$out"
  git clone --quiet --branch "$branch" "$REMOTE" "$out" 2>/dev/null || return 0
  rm -rf "$out/.git"
}

# Only the verbs registerctl actually calls. An arm for a verb nothing
# invokes is untested code that reads as coverage.
case "${1:-}" in
  auth)
    # Authenticated. The skill's own gate is bash, and bash unit tests cover
    # it far more cheaply than a model can.
    exit 0
    ;;
  repo)
    [[ "${2:-}" == "clone" ]] || die "unexpected: gh repo $*"
    seed_remote
    # gh repo clone <slug> <dir> -- <git args...>
    git clone --quiet "$REMOTE" "$4"
    ;;
  --repo)
    # gh --repo <slug> pr create --base ... --head <branch> ...
    [[ "${3:-}" == "pr" && "${4:-}" == "create" ]] || die "unexpected: gh $*"
    branch=""
    for ((i = 1; i <= $#; i++)); do
      if [[ "${!i}" == "--head" ]]; then
        j=$((i + 1))
        branch="${!j}"
      fi
    done
    [[ -n "$branch" ]] || die "gh pr create without --head"
    export_branch "$branch"
    echo "https://github.com/acme/platform/pull/1"
    ;;
  *)
    # A verb this double does not answer must fail loudly. Exiting 0 would
    # hand the skill an empty success and score the run on it.
    die "unexpected: gh $*"
    ;;
esac
